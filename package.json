{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "obsidian-search",
	"version": "0.1.3",
	"description": "",
	"main": "dist/main.cjs",
	"module": "dist/main.mjs",
	"typings": "dist/main.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"fmt": "node ./scripts/fmt.js",
		"lint": "oxlint .c ./scripts/oxlint.json",
		"build": "node ./build.js",
		"test:unit": "tsx --test ./src/**/*.test.ts",
		"test:obsidian": "obsidian-test --setup ./scripts/test/obsidian.js",
		"test:conform": "obsidian-test --setup ./scripts/test/conform.js",
		"test": "pnpm test:unit & pnpm test:obsidian & pnpm test:conform"
	},
	"repository": {
		"type": "git",
		"url": "github.com/b-camphart/obsidian-search"
	},
	"keywords": [
		"obsidian",
		"search"
	],
	"author": "b-camphart",
	"license": "ISC",
	"devDependencies": {
		"@stryker-mutator/vitest-runner": "^9.5.1",
		"@types/node": "latest",
		"obsidian": "latest",
		"obsidian-test": "^0.1.2",
		"oxlint": "^1.50.0",
		"prettier": "latest",
		"source-map": "^0.7.6",
		"source-map-support": "^0.5.21",
		"tree-kill": "^1.2.2",
		"tsx": "^4.21.0",
		"typescript": "latest",
		"vite": "latest",
		"vite-plugin-dts": "3.6.4",
		"vitest": "latest",
		"yaml": "^2.8.2"
	},
	"packageManager": "pnpm@10.32.1"
}
